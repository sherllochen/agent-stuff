# do-it reviewer model settings, linked to ~/.config/do-it/config by
# `agent-stuff install-custom-skills`. Applies to every repository.
#
# Format: KEY=value, one per line. Lines starting with # are ignored.
# Exported environment variables with the same names override this file.
# Uncomment a line to override the built-in default shown.

# Copilot: any model ID available in your session.
# DO_IT_REVIEWER_MODEL_COPILOT=gpt-5.3-codex

# Claude Code: opus | sonnet | haiku | fable
# DO_IT_REVIEWER_MODEL_CLAUDE=opus

# Antigravity: inherit | flash | pro
# DO_IT_REVIEWER_MODEL_ANTIGRAVITY=pro

# Fallback for any harness, used only when the value is valid there.
# DO_IT_REVIEWER_MODEL=
